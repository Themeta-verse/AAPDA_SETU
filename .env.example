# AAPDA SETU Environment Configuration Template
# These are the canonical environment variables required by Vite and Supabase.
# In Vercel, add these under Project Settings > Environment Variables for Production, Preview, and Development.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
